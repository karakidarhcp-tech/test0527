# Google Cloud デプロイ設定
# このファイルを config.env という名前でコピーし、PROJECT_ID を書き換えてください。
#   cp deploy/gcp/config.env.example deploy/gcp/config.env

# Google Cloud のプロジェクトID（コンソール上部のプロジェクト選択で確認できます）
PROJECT_ID=your-project-id

# リージョン（asia-northeast1 = 東京）
REGION=asia-northeast1

# Cloud Run のサービス名（URLの先頭になります）
SERVICE=anken

# Cloud SQL のインスタンス名・DB名・DBユーザー名
SQL_INSTANCE=anken-db
DB_NAME=anken
DB_USER=anken

# Cloud SQL のマシンタイプ。db-f1-micro は最小構成（数十人規模の社内利用向け）
SQL_TIER=db-f1-micro

# 初期管理者のユーザー名（パスワードは setup.sh が自動生成して表示します）
ADMIN_USERNAME=admin

# 独自ドメインを使う場合のみ設定（例: anken.example.co.jp）。空なら *.run.app のURL
CUSTOM_DOMAIN=
